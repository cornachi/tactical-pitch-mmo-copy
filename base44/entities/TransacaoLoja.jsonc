{
  "name": "TransacaoLoja",
  "type": "object",
  "properties": {
    "clube_id": {
      "type": "string",
      "title": "Clube ID",
      "description": "ID do clube que realizou a transa\u00e7\u00e3o"
    },
    "pacote_id": {
      "type": "string",
      "title": "Pacote ID",
      "description": "Identificador do pacote comprado"
    },
    "valor_reais": {
      "type": "number",
      "title": "Valor em Reais",
      "description": "Valor da transa\u00e7\u00e3o em reais (BRL)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "PENDENTE",
        "CONCLUIDO"
      ],
      "default": "PENDENTE"
    }
  },
  "required": [
    "clube_id",
    "pacote_id",
    "valor_reais"
  ]
}