{
  "name": "Temporada",
  "type": "object",
  "properties": {
    "mes_ano": {
      "type": "string",
      "title": "M\u00eas/Ano",
      "description": "Identificador da temporada no formato 'YYYY-MM' (ex: '2026-08')"
    },
    "evento_meta_atual": {
      "type": "string",
      "title": "Evento Meta Atual",
      "description": "Evento tem\u00e1tico da temporada (ex: 'FUTEBOL_FISICO')"
    },
    "ativa": {
      "type": "boolean",
      "title": "Ativa",
      "default": false
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "title": "Data de In\u00edcio"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "title": "Data de Fim"
    },
    "pote_global": {
      "type": "integer",
      "title": "Pote Global da Temporada",
      "default": 5000,
      "description": "Pote Comunit\u00e1rio acumulado (5% do valor envolvido em partidas, desafios e loja)"
    }
  },
  "required": [
    "mes_ano",
    "data_inicio",
    "data_fim"
  ]
}