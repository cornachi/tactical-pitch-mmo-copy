{
  "name": "Clube",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID",
      "description": "ID do usu\u00e1rio dono do clube"
    },
    "nome_clube": {
      "type": "string",
      "title": "Nome do Clube"
    },
    "pais": {
      "type": "string",
      "title": "Pa\u00eds"
    },
    "moedas": {
      "type": "integer",
      "title": "Moedas",
      "default": 1000,
      "description": "Moedas do clube (bigint, padr\u00e3o 1000)"
    },
    "xp": {
      "type": "integer",
      "title": "XP",
      "default": 0,
      "description": "Experi\u00eancia do clube (bigint, padr\u00e3o 0)"
    },
    "ranking_elo": {
      "type": "integer",
      "title": "Ranking Elo (legado)",
      "default": 1000,
      "description": "Campo legado do antigo sistema Elo \u2014 n\u00e3o \u00e9 mais usado pelo ranking (substitu\u00eddo por pontos_ranking)."
    },
    "pontos_ranking": {
      "type": "integer",
      "title": "Pontos do Ranking",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o direta da temporada: 3 por vit\u00f3ria, 1 por empate, 0 por derrota (apenas matchmaking). Zera a cada temporada."
    },
    "energia_matchmaking": {
      "type": "integer",
      "title": "Energia Matchmaking",
      "default": 6
    },
    "energia_desafio": {
      "type": "integer",
      "title": "Energia Desafio",
      "default": 3
    },
    "energias_compradas_hoje": {
      "type": "integer",
      "title": "Energias Compradas Hoje",
      "default": 0,
      "description": "Contador di\u00e1rio de energias compradas (teto 20, resetado \u00e0 meia-noite)"
    },
    "win_streak": {
      "type": "integer",
      "title": "Win Streak",
      "default": 0
    },
    "especializacao": {
      "type": "string",
      "title": "Especializa\u00e7\u00e3o",
      "enum": [
        "POSSE",
        "CONTRA_ATAQUE",
        "PRESSAO",
        "EQUILIBRADO"
      ],
      "default": "EQUILIBRADO"
    },
    "is_bot": {
      "type": "boolean",
      "title": "\u00c9 Bot",
      "default": false,
      "description": "Indica se o clube \u00e9 controlado por IA (seeding de bots)"
    },
    "cor_principal": {
      "type": "string",
      "title": "Cor Principal",
      "default": "#3b82f6"
    },
    "cor_secundaria": {
      "type": "string",
      "title": "Cor Secund\u00e1ria",
      "default": "#ffffff"
    },
    "icone_escudo": {
      "type": "string",
      "title": "\u00cdcone do Escudo",
      "default": "escudo"
    },
    "estadio_nivel": {
      "type": "integer",
      "title": "N\u00edvel do Est\u00e1dio",
      "default": 0,
      "description": "N\u00edvel infinito do est\u00e1dio (+2% moedas mandante/n\u00edvel)"
    },
    "ct_nivel": {
      "type": "integer",
      "title": "N\u00edvel do CT",
      "default": 0,
      "description": "N\u00edvel infinito do Centro de Treinamento (+1% desconto atributos/n\u00edvel, teto 85%)"
    },
    "medico_nivel": {
      "type": "integer",
      "title": "N\u00edvel do Dept. M\u00e9dico",
      "default": 0,
      "description": "Aumenta o teto e a recupera\u00e7\u00e3o de energia"
    },
    "comissao_prep_fisico": {
      "type": "integer",
      "title": "Preparador F\u00edsico",
      "default": 0
    },
    "comissao_analista": {
      "type": "integer",
      "title": "Analista de Desempenho",
      "default": 0
    },
    "comissao_auxiliar_tatico": {
      "type": "integer",
      "title": "Auxiliar T\u00e1tico",
      "default": 0
    },
    "termometro_torcida": {
      "type": "integer",
      "title": "Term\u00f4metro da Torcida",
      "default": 50,
      "description": "Moral da torcida (0-100). 0-25 revolta (penalidade no fator casa), 81-100 \u00eaxtase (+5% resili\u00eancia em casa). Atualizado ap\u00f3s cada partida."
    }
  },
  "required": [
    "user_id",
    "nome_clube",
    "pais"
  ]
}