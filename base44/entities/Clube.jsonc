{
  "name": "Clube",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID",
      "description": "ID do usu\u00e1rio dono do clube"
    },
    "nome_clube": {
      "type": "string",
      "title": "Nome do Clube"
    },
    "pais": {
      "type": "string",
      "title": "Pa\u00eds"
    },
    "moedas": {
      "type": "integer",
      "title": "Moedas",
      "default": 1000,
      "description": "Moedas do clube (bigint, padr\u00e3o 1000)"
    },
    "xp": {
      "type": "integer",
      "title": "XP",
      "default": 0,
      "description": "Experi\u00eancia do clube (bigint, padr\u00e3o 0)"
    },
    "ranking_elo": {
      "type": "integer",
      "title": "Ranking Elo",
      "default": 1000
    },
    "energia_matchmaking": {
      "type": "integer",
      "title": "Energia Matchmaking",
      "default": 6
    },
    "energia_desafio": {
      "type": "integer",
      "title": "Energia Desafio",
      "default": 3
    },
    "win_streak": {
      "type": "integer",
      "title": "Win Streak",
      "default": 0
    },
    "especializacao": {
      "type": "string",
      "title": "Especializa\u00e7\u00e3o",
      "enum": [
        "POSSE",
        "CONTRA_ATAQUE",
        "PRESSAO",
        "EQUILIBRADO"
      ],
      "default": "EQUILIBRADO"
    },
    "is_bot": {
      "type": "boolean",
      "title": "\u00c9 Bot",
      "default": false,
      "description": "Indica se o clube \u00e9 controlado por IA (seeding de bots)"
    },
    "cor_principal": {
      "type": "string",
      "title": "Cor Principal",
      "default": "#3b82f6",
      "description": "Cor prim\u00e1ria da identidade visual do clube (hex)"
    },
    "cor_secundaria": {
      "type": "string",
      "title": "Cor Secund\u00e1ria",
      "default": "#ffffff",
      "description": "Cor secund\u00e1ria da identidade visual do clube (hex)"
    },
    "icone_escudo": {
      "type": "string",
      "title": "\u00cdcone do Escudo",
      "default": "escudo",
      "description": "Chave do \u00edcone do escudo (escudo, estrela, coroa, etc.)"
    }
  },
  "required": [
    "user_id",
    "nome_clube",
    "pais"
  ]
}