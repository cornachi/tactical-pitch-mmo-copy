{
  "name": "HistoricoPartida",
  "type": "object",
  "properties": {
    "desafiante_id": {
      "type": "string",
      "title": "Desafiante ID",
      "description": "ID do clube desafiante"
    },
    "desafiado_id": {
      "type": "string",
      "title": "Desafiado ID",
      "description": "ID do clube desafiado"
    },
    "tipo": {
      "type": "string",
      "title": "Tipo de Partida",
      "enum": [
        "MATCHMAKING",
        "DESAFIO"
      ]
    },
    "placar_home": {
      "type": "integer",
      "title": "Placar Home",
      "default": 0
    },
    "placar_away": {
      "type": "integer",
      "title": "Placar Away",
      "default": 0
    },
    "xg_home": {
      "type": "number",
      "title": "xG Home",
      "default": 0,
      "description": "Expected goals do time da casa"
    },
    "xg_away": {
      "type": "number",
      "title": "xG Away",
      "default": 0,
      "description": "Expected goals do time visitante"
    },
    "dominancia_home": {
      "type": "number",
      "title": "Domin\u00e2ncia Home",
      "default": 0,
      "description": "Percentual de domin\u00e2ncia do time da casa (0-100)"
    },
    "aposta_moedas": {
      "type": "integer",
      "title": "Aposta em Moedas",
      "default": 0,
      "description": "Moedas apostas na partida (bigint, padr\u00e3o 0)"
    },
    "insights": {
      "type": "object",
      "title": "Insights",
      "description": "Dados detalhados da partida em JSON (estat\u00edsticas, eventos, etc.)",
      "additionalProperties": true
    }
  },
  "required": [
    "desafiante_id",
    "desafiado_id",
    "tipo"
  ]
}