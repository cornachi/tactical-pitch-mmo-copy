{
  "name": "Torneio",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome do Torneio"
    },
    "criador_id": {
      "type": "string",
      "title": "Criador ID",
      "description": "ID do clube que criou o torneio"
    },
    "taxa_inscricao": {
      "type": "integer",
      "title": "Taxa de Inscri\u00e7\u00e3o",
      "default": 0,
      "description": "Moedas cobradas de cada participante (0 = gratuito)"
    },
    "codigo_convite": {
      "type": "string",
      "title": "C\u00f3digo de Convite",
      "description": "C\u00f3digo privado de 6 caracteres para entrar no torneio"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "MONTANDO",
        "EM_ANDAMENTO",
        "CONCLUIDO"
      ],
      "default": "MONTANDO"
    },
    "participantes": {
      "type": "array",
      "title": "Participantes",
      "description": "IDs dos clubes inscritos (m\u00e1x. 8)",
      "items": {
        "type": "string"
      }
    },
    "rodadas": {
      "type": "object",
      "title": "Rodadas",
      "description": "JSON do mata-mata: Quartas de Final, Semifinal e Final",
      "additionalProperties": true
    },
    "campeao_id": {
      "type": "string",
      "title": "Campe\u00e3o ID"
    },
    "vice_id": {
      "type": "string",
      "title": "Vice ID"
    },
    "pote_moedas": {
      "type": "integer",
      "title": "Pote de Moedas",
      "default": 0,
      "description": "Acumulado das taxas de inscri\u00e7\u00e3o (dividido 70/30 entre campe\u00e3o e vice)"
    }
  },
  "required": [
    "nome",
    "criador_id",
    "codigo_convite",
    "status"
  ]
}