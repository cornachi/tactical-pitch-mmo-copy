{
  "name": "Reset Di\u00e1rio de Energia",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reset_diario_energia",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reset_energia": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "resetEnergiaDiaria"
          },
          "then": "end",
          "x-base44": {
            "title": "Resetar energia di\u00e1ria",
            "description": "Reseta a energia de todos os clubes"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Reseta a energia di\u00e1ria de todos os clubes todos os dias \u00e0 meia-noite, sem data de t\u00e9rmino."
}